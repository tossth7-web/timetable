{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "课表主窗口所需权限：文件对话框、读写用户选中的文件（教务窗口的权限在 admin.json）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }]
    }
  ]
}
